generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        Int            @id @default(autoincrement())
  title     String
  createdAt DateTime       @default(now())
  sessions  StudySession[]
}

// A session with endedAt = null is the running timer.
// A partial unique index in the migration SQL allows at most one running session.
model StudySession {
  id              Int       @id @default(autoincrement())
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  @@index([projectId])
  @@index([startedAt])
}
