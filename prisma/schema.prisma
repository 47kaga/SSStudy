generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id         Int            @id @default(autoincrement())
  title      String
  createdAt  DateTime       @default(now())
  archivedAt DateTime?
  sessions   StudySession[]
}

// A session with endedAt = null is the running timer.
// A partial unique index in the migration SQL allows at most one running session.
model StudySession {
  id              Int       @id @default(autoincrement())
  projectId       Int
  project         Project   @relation(fields: [projectId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  @@index([projectId])
  @@index([startedAt])
}

// Spike model for the quiz pipeline. The pasted source text is never stored.
model Quiz {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  model          String
  questionsJson  String // full questions with correctIndex, already shuffled
  sourceChars    Int
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int
  gradedAt       DateTime?
  correctAnswers Int?
  totalQuestions Int
}

// Append-only. The shard balance is the sum of amounts. Never edit or delete rows.
model ShardLedger {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  amount    Int // positive = earned or granted, negative = spent
  reason    String // for example "dev-grant" or "pull:<itemKey>"
}

model InventoryItem {
  id              Int      @id @default(autoincrement())
  itemKey         String   @unique
  count           Int
  firstObtainedAt DateTime @default(now())
}
